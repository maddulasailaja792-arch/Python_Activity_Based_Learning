# Examination Result and Grace-Mark Validation

print("EXAMINATION RESULT AND GRACE-MARK VALIDATION")

name = input("Enter student name: ")
n = int(input("Enter number of subjects: "))

MAX_GRACE = 5
total_marks = 0
total_maximum = 0
all_passed = True

subjects = []

for i in range(n):
    print(f"\nSubject {i + 1}")

    subject = input("Enter subject name: ")
    maximum = int(input("Enter maximum marks: "))
    pass_mark = int(input("Enter minimum pass marks: "))
    obtained = int(input("Enter obtained marks: "))

    # Validate input marks
    if maximum <= 0 or pass_mark < 0 or pass_mark > maximum:
        print("Invalid maximum or pass marks. Try again.")
        exit()

    if obtained < 0 or obtained > maximum:
        print("Invalid obtained marks. Try again.")
        exit()

    grace = 0

    # Apply grace marks if eligible
    if obtained < pass_mark:
        shortage = pass_mark - obtained

        if shortage <= MAX_GRACE:
            grace = min(shortage, MAX_GRACE, maximum - obtained)
            obtained += grace

    # Check final subject result
    if obtained < pass_mark:
        result = "FAIL"
        all_passed = False
    else:
        result = "PASS"

    subjects.append(
        (subject, obtained, maximum, grace, result)
    )

    total_marks += obtained
    total_maximum += maximum

# Calculate percentage
percentage = (total_marks / total_maximum) * 100

# Determine final result and classification
if not all_passed:
    final_result = "FAIL"
    classification = "Fail"
elif percentage >= 75:
    final_result = "PASS"
    classification = "Distinction"
elif percentage >= 60:
    final_result = "PASS"
    classification = "First Class"
elif percentage >= 50:
    final_result = "PASS"
    classification = "Second Class"
elif percentage >= 35:
    final_result = "PASS"
    classification = "Pass Class"
else:
    final_result = "FAIL"
    classification = "Fail"

# Display final results
print("\n========== FINAL RESULT ==========")
print("Student Name:", name)
print("\nSubject-wise Results:")

for subject, marks, maximum, grace, result in subjects:
    print(
        f"{subject}: {marks}/{maximum}, "
        f"Grace Marks: {grace}, Result: {result}"
    )

print("\nTotal Marks:", total_marks, "/", total_maximum)
print("Percentage:", round(percentage, 2), "%")
print("Final Result:", final_result)
print("Classification:", classification)

print("==================================")
